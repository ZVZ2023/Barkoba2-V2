{
  "name": "barkoba",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:isolation && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts test/*.test.ts",
    "check:isolation": "node scripts/check-isolation.mjs",
    "verify": "npm run check:isolation && npm run test && npm run typecheck && npm run build",
    "eval:adjudicator": "tsx scripts/evalAdjudicator.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.11",
    "typescript": "^5.5.3"
  }
}
