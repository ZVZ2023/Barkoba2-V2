# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# Existing Digital Ice Cream storefront. Barkóba adds only an opaque purchase
# reference; DICS products, prices and customer-facing offers stay unchanged.
DICS_STOREFRONT_URL=https://zvz2023.github.io/Lighthouse/digital-ice-cream/

# --- Model routing (configurable, no code changes needed to swap) ---
# Fast/cheap model for the repeated per-turn Racer loop.
ANTHROPIC_MODEL_RACER=claude-haiku-4-5-20251001
# Strong reasoning model for Validator, Adjudicator, Integrity Review (each fires once/game).
ANTHROPIC_MODEL_STRONG=claude-sonnet-5

# --- Rate limiting ---
# Set to "true" only in local/dev environments to bypass entirely.
RATE_LIMIT_DISABLED=false
RATE_LIMIT_GAMES_PER_HOUR=5

# --- Game config ---
MAX_QUESTIONS=20
GAME_TTL_SECONDS=86400
# --- Global spend ceiling (all users, all IPs, per UTC day) ---
# Hard stop on Racer model calls. Fails CLOSED: if the counter is unreachable,
# calls are denied. A full 20-question game costs ~20-25 calls.
RACER_DAILY_CALL_CEILING=2000
# Adjudicator + Integrity Review. Strong model, <=2 calls per completed game
# (1 when the Racer guesses correctly — the Integrity Review is skipped, not
# run and discarded). Separate counter so Racer traffic cannot starve it.
RESOLVE_DAILY_CALL_CEILING=300

# --- Persistence (Upstash Redis) ---
# Leave unset for local dev — falls back to an in-memory store (does not
# persist across restarts). Required for any real deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- V2.1.1: anonymous Player identity ---
# HMAC key for signing the player cookie. Any long random string; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST differ from the V1 deployment's value — V1 and V2 identities never mix.
# If unset, player identity is DISABLED rather than unsigned: the game stays
# fully playable and no forgeable identifier is ever minted. Rotating this value
# invalidates every existing anonymous player.
PLAYER_ID_SECRET=

# --- V2.2: durable game corpus (Neon / PostgreSQL) ---
# PostgreSQL is durable memory; Redis stays operational state. Nothing that
# currently lives in Redis moves here.
# Neon connection string. Already configured in Vercel Production and Preview.
#
# Must be the RAW string: postgresql://user:password@host/dbname?sslmode=require
# NOT wrapped in quotes, and NOT the `psql '...'` form Neon's dashboard offers
# on its psql tab — the driver throws on both. 2.2.0.1 lost a production game to
# exactly that, and reported "ready" while doing it.
#
# GET /api/version confirms what the deployed runtime actually has:
#   corpus.database_url_valid    false means the driver cannot use it
#   corpus.database_url_problem  wrapped_in_quotes | psql_prefix | missing_username | ...
#   corpus.host / corpus.database   which Neon branch and database it points at
# Compare host against the branch the migration was applied to. They are not
# guaranteed to match: the migration runs from a shell, the app from Vercel.
DATABASE_URL=

# Master switch for corpus writes. DEFAULT OFF.
# Deployment order this exists to allow: apply the migration, deploy the code,
# verify nothing changed, and only then set this to "true". It is also the
# fastest rollback if corpus writes ever misbehave — no redeploy, no revert.
#
# Accepted as ON: true, 1, yes, on — case-insensitive, surrounding whitespace
# and quotes ignored. Anything else is OFF. (2.2.0.0 required exactly "true",
# so a stray space or capital silently disabled the corpus with no log at all.)
#
# To confirm the deployed runtime actually sees it:  GET /api/version
#   -> corpus.reason == "ready"              recording
#      corpus.reason == "flag_unset"         variable absent from this runtime
#      corpus.reason == "flag_not_enabled"   present but not readable as true
#      corpus.reason == "no_database_url"    DATABASE_URL not visible here
CORPUS_ENABLED=false

# Provenance stamp on every corpus row. NOT a legal consent basis: it records
# which collection regime a game was captured under, so this pre-public
# family/test research corpus stays distinguishable from anything later
# gathered under public disclosure and consent.
COLLECTION_CONTEXT=pre_public_research

# How many deferred games one opportunistic reconciliation pass will replay.
# Bounded so a backlog can never turn game creation into a batch job.
CORPUS_RECONCILE_BATCH=3

# --- V2.4: Play Credit entitlement ---
# Play Credit is an internal entitlement unit. NOT a game, a model call, a
# token, a currency, or the SÚGÓ/clue credit (that one is derived per game in
# lib/clueCredits.ts and shares nothing with this).
#
# Master switch for the game-creation gate. DEFAULT OFF.
# Deployment order: migrate, deploy, verify nothing changed, then enable.
ENTITLEMENTS_ENABLED=false

# First-contact allowance, granted at most once per player.
# Spendable on any tier, including budget-100 (cost 1). No complimentary-
# specific cap: RACER_DAILY_CALL_CEILING is the systemwide backstop.
ENTITLEMENT_COMPLIMENTARY_GRANT=10

# NOTE: there is no per-game cost setting. Cost is derived server-side from the
# the resolved question budget (lib/questionBudget.ts): every offered tier costs
# one internal Play Credit, so one player-facing RACE always means one playable
# run. Keeping it out of the environment is deliberate — no deployment setting,
# and therefore no caller, can state what a run costs.

# --- V2.5-B3: xAI / Grok as a selectable Racer ---
# SERVER SIDE ONLY. Never prefix with NEXT_PUBLIC_ and never return it from a
# route — no browser may ever hold it.
#
# OPTIONAL. Leave it unset and Barkóba runs exactly as before: Claude races,
# and choosing Grok is REFUSED with a clear message. It never falls back to
# Claude silently, because a game the player believes Grok played and the
# record shows Claude played is worse than no game at all.
XAI_API_KEY=

# Which Grok model fills the guessing seat. Server-controlled: no request can
# state a model id, so nobody can put an arbitrary model on the bill or into
# the corpus. The recorded model id proves which really played either way.
#
# MEASURED, Step 0 probe, same prompt and schema, 3 runs each:
#   grok-4.6 (default effort "high")  median 69.3s  — ABOVE the 60s function
#                                                     ceiling; turns get killed
#   grok-4.6 + reasoning_effort=low   median 10.0s  — viable fallback
#   grok-4.20-0309-non-reasoning      median  2.6s  — field-test scout
#   grok-4.3 + effort=none            median  1.7s  — reserve, untested for play
#
# All four passed the forced-tool contract 3/3. The shipped default stays
# grok-4.6 so an unconfigured deployment behaves as it always has; the field
# test is switched on by SETTING this variable, not by changing the default.
# Changing the default would mean a future deploy without the variable silently
# racing a different model.
#
# Field test: XAI_MODEL_RACER=grok-4.20-0309-non-reasoning
# Confirm what a runtime actually resolved at GET /api/version -> racer.xai_model
XAI_MODEL_RACER=grok-4.6

# Minimum output allowance for one Grok turn. Grok 4.6 is a reasoning model and
# its reasoning tokens count against this cap; the 512 that fits Claude Haiku
# can cut a reasoning model off before it reaches its answer, which would look
# like bad play rather than a truncated response. TRANSPORT ONLY — the prompt,
# schema, transcript and question budget are identical for both providers.
XAI_MAX_TOKENS_RACER=2048

# --- V2.5: Game Intelligence benchmark ingress ---
# Shared secret authorising a game to be TAGGED as a benchmark run at creation,
# via the x-barkoba-benchmark-secret / x-barkoba-benchmark-case header pair.
#
# LEAVE UNSET unless you are actually running benchmark games. Unset means
# tagging is out of service and every attempt is silently ignored — the game is
# still created, just untagged, which is the correct default. It must never fall
# open: a benchmark set any client can write into is not a benchmark set, and
# because corpus.games is immutable once finalized, a mistag can never be
# removed.
#
# Deliberately NOT the same secret as ENTITLEMENT_GRANT_SECRET. Two unrelated
# authorities — one hands out money-adjacent value, one labels research
# evidence — and sharing a secret would make a rotation or leak in either
# blast-radius into the other.
BENCHMARK_INGRESS_SECRET=

# --- KV namespace ---
# Prefix applied to every KV key. Leave EMPTY for V1: an unset namespace
# reproduces the exact key shapes V1 has always written, so V1 needs no change.
# V2 sets this (e.g. "v2:") so both lanes can share one Upstash database without
# sharing game state, rate-limit counters, or daily AI spend ceilings.
# NOTE: this separates the DATA, not the account. Free-tier command and storage
# quotas remain shared until a second database is available.
KV_NAMESPACE=

# --- V2.6.x: registration upgrade (email verification + profile photo) ---
# NOT YET READ BY ANY CODE PATH. lib/emailVerification.ts's sendVerificationEmail()
# is a stub — it logs the link it would send and returns, without checking this
# variable at all. Setting it does nothing today; wiring it up is the
# `// TODO: wire to Resend once RESEND_API_KEY exists` in that file.
RESEND_API_KEY=

# NOT YET READ BY ANY CODE PATH. lib/photoUpload.ts's uploadProfilePhoto() is a
# stub — it logs what it would upload and returns a placeholder URL, without
# checking this variable at all. Setting it does nothing today; wiring it up is
# the `// TODO: wire to Vercel Blob once BLOB_READ_WRITE_TOKEN exists` in that
# file. (Also requires enabling Blob storage on the Vercel project itself —
# this variable alone is not sufficient.)
BLOB_READ_WRITE_TOKEN=
