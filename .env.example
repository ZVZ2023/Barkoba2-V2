# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Model routing (configurable, no code changes needed to swap) ---
# Fast/cheap model for the repeated per-turn Racer loop.
ANTHROPIC_MODEL_RACER=claude-haiku-4-5-20251001
# Strong reasoning model for Validator, Adjudicator, Integrity Review (each fires once/game).
ANTHROPIC_MODEL_STRONG=claude-sonnet-5

# --- Rate limiting ---
# Set to "true" only in local/dev environments to bypass entirely.
RATE_LIMIT_DISABLED=false
RATE_LIMIT_GAMES_PER_HOUR=5

# --- Game config ---
MAX_QUESTIONS=20
GAME_TTL_SECONDS=86400
# --- Global spend ceiling (all users, all IPs, per UTC day) ---
# Hard stop on Racer model calls. Fails CLOSED: if the counter is unreachable,
# calls are denied. A full 20-question game costs ~20-25 calls.
RACER_DAILY_CALL_CEILING=2000
# Adjudicator + Integrity Review. Strong model, <=2 calls per completed game
# (1 when the Racer guesses correctly — the Integrity Review is skipped, not
# run and discarded). Separate counter so Racer traffic cannot starve it.
RESOLVE_DAILY_CALL_CEILING=300

# --- Persistence (Upstash Redis) ---
# Leave unset for local dev — falls back to an in-memory store (does not
# persist across restarts). Required for any real deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- V2.1.1: anonymous Player identity ---
# HMAC key for signing the player cookie. Any long random string; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST differ from the V1 deployment's value — V1 and V2 identities never mix.
# If unset, player identity is DISABLED rather than unsigned: the game stays
# fully playable and no forgeable identifier is ever minted. Rotating this value
# invalidates every existing anonymous player.
PLAYER_ID_SECRET=

# --- V2.2: durable game corpus (Neon / PostgreSQL) ---
# PostgreSQL is durable memory; Redis stays operational state. Nothing that
# currently lives in Redis moves here.
# Neon connection string. Already configured in Vercel Production and Preview.
#
# Must be the RAW string: postgresql://user:password@host/dbname?sslmode=require
# NOT wrapped in quotes, and NOT the `psql '...'` form Neon's dashboard offers
# on its psql tab — the driver throws on both. 2.2.0.1 lost a production game to
# exactly that, and reported "ready" while doing it.
#
# GET /api/version confirms what the deployed runtime actually has:
#   corpus.database_url_valid    false means the driver cannot use it
#   corpus.database_url_problem  wrapped_in_quotes | psql_prefix | missing_username | ...
#   corpus.host / corpus.database   which Neon branch and database it points at
# Compare host against the branch the migration was applied to. They are not
# guaranteed to match: the migration runs from a shell, the app from Vercel.
DATABASE_URL=

# Master switch for corpus writes. DEFAULT OFF.
# Deployment order this exists to allow: apply the migration, deploy the code,
# verify nothing changed, and only then set this to "true". It is also the
# fastest rollback if corpus writes ever misbehave — no redeploy, no revert.
#
# Accepted as ON: true, 1, yes, on — case-insensitive, surrounding whitespace
# and quotes ignored. Anything else is OFF. (2.2.0.0 required exactly "true",
# so a stray space or capital silently disabled the corpus with no log at all.)
#
# To confirm the deployed runtime actually sees it:  GET /api/version
#   -> corpus.reason == "ready"              recording
#      corpus.reason == "flag_unset"         variable absent from this runtime
#      corpus.reason == "flag_not_enabled"   present but not readable as true
#      corpus.reason == "no_database_url"    DATABASE_URL not visible here
CORPUS_ENABLED=false

# Provenance stamp on every corpus row. NOT a legal consent basis: it records
# which collection regime a game was captured under, so this pre-public
# family/test research corpus stays distinguishable from anything later
# gathered under public disclosure and consent.
COLLECTION_CONTEXT=pre_public_research

# How many deferred games one opportunistic reconciliation pass will replay.
# Bounded so a backlog can never turn game creation into a batch job.
CORPUS_RECONCILE_BATCH=3

# --- V2.4: Play Credit entitlement ---
# Play Credit is an internal entitlement unit. NOT a game, a model call, a
# token, a currency, or the SÚGÓ/clue credit (that one is derived per game in
# lib/clueCredits.ts and shares nothing with this).
#
# Master switch for the game-creation gate. DEFAULT OFF.
# Deployment order: migrate, deploy, verify nothing changed, then enable.
# WARNING: enabling this with no complimentary grant configured and no
# purchased balance blocks game creation for everyone — a gate with nothing
# behind it. Set ENTITLEMENT_COMPLIMENTARY_GRANT before switching this on.
ENTITLEMENTS_ENABLED=false

# Play Credits charged per game started. A single flat provisional cost —
# deliberately NOT a game_type -> cost mapping; that is future work.
ENTITLEMENT_COST_PER_GAME=1

# Optional first-contact allowance, granted at most once per player.
# 0 = no automatic grant. The quantity is a product decision, not a default.
ENTITLEMENT_COMPLIMENTARY_GRANT=0

# --- KV namespace ---
# Prefix applied to every KV key. Leave EMPTY for V1: an unset namespace
# reproduces the exact key shapes V1 has always written, so V1 needs no change.
# V2 sets this (e.g. "v2:") so both lanes can share one Upstash database without
# sharing game state, rate-limit counters, or daily AI spend ceilings.
# NOTE: this separates the DATA, not the account. Free-tier command and storage
# quotas remain shared until a second database is available.
KV_NAMESPACE=
